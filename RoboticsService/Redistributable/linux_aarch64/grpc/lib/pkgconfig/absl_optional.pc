prefix=/home/orin_pico/.local
exec_prefix=${prefix}
libdir=/home/orin_pico/.local/lib
includedir=/home/orin_pico/.local/include

Name: absl_optional
Description: Abseil optional library
URL: https://abseil.io/
Version: 20240116
Requires: absl_bad_optional_access = 20240116, absl_base_internal = 20240116, absl_config = 20240116, absl_core_headers = 20240116, absl_memory = 20240116, absl_nullability = 20240116, absl_type_traits = 20240116, absl_utility = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
