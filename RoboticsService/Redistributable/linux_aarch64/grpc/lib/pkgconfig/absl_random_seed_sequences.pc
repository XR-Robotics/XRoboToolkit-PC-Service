prefix=/home/orin_pico/.local
exec_prefix=${prefix}
libdir=/home/orin_pico/.local/lib
includedir=/home/orin_pico/.local/include

Name: absl_random_seed_sequences
Description: Abseil random_seed_sequences library
URL: https://abseil.io/
Version: 20240116
Requires: absl_config = 20240116, absl_inlined_vector = 20240116, absl_random_internal_pool_urbg = 20240116, absl_random_internal_salted_seed_seq = 20240116, absl_random_internal_seed_material = 20240116, absl_random_seed_gen_exception = 20240116, absl_span = 20240116
Libs: -L${libdir}  -labsl_random_seed_sequences 
Cflags: -I${includedir} -DNOMINMAX
