prefix=/home/orin_pico/.local
exec_prefix=${prefix}
libdir=/home/orin_pico/.local/lib
includedir=/home/orin_pico/.local/include

Name: absl_debugging_internal
Description: Abseil debugging_internal library
URL: https://abseil.io/
Version: 20240116
Requires: absl_core_headers = 20240116, absl_config = 20240116, absl_dynamic_annotations = 20240116, absl_errno_saver = 20240116, absl_raw_logging_internal = 20240116
Libs: -L${libdir}  -labsl_debugging_internal 
Cflags: -I${includedir} -DNOMINMAX
