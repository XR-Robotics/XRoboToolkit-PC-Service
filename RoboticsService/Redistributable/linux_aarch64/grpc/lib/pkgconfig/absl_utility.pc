prefix=/home/orin_pico/.local
exec_prefix=${prefix}
libdir=/home/orin_pico/.local/lib
includedir=/home/orin_pico/.local/include

Name: absl_utility
Description: Abseil utility library
URL: https://abseil.io/
Version: 20240116
Requires: absl_base_internal = 20240116, absl_config = 20240116, absl_type_traits = 20240116
Libs: -L${libdir}  
Cflags: -I${includedir} -DNOMINMAX
